# Task T-206: Root environment variables for Docker Compose
# Copy to .env and configure for your environment

# Database Configuration (NeonDB)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# JWT Configuration (Task T-213)
# Generate a 256-bit secret: openssl rand -base64 32
JWT_SECRET_KEY=your-256-bit-secret-key-change-in-production

# Frontend Configuration (Task T-201)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Configuration (Task T-202)
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
DEBUG=True

# AI/LLM API Keys
GEMINI_API_KEY=your-gemini-api-key-here

# MCP Configuration
MCP_INTERNAL_SECRET=mcp-internal-secret-change-in-production
